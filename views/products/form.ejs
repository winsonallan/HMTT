<% const title = product && product.id ? 'Edit Product' : 'New Product' %>
<%- include('../partials/header') %>

<h3 class="mb-3"><%= title %></h3>

<div class="card p-4" style="max-width:500px;">
  <% if (error) { %><div class="alert alert-danger"><%= error %></div><% } %>
  <form method="POST" action="<%= product && product.id ? '/products/' + product.id + '?_method=PUT' : '/products' %>">
    <div class="mb-3">
      <label class="form-label">Name</label>
      <input type="text" name="name" class="form-control" value="<%= product ? product.name : '' %>" required>
    </div>
    <div class="mb-3">
      <label class="form-label">Category</label>
      <select name="category" class="form-select" required>
        <option value="Regular" <%= product && product.category === 'Regular' ? 'selected' : '' %>>Regular</option>
        <option value="Premium" <%= product && product.category === 'Premium' ? 'selected' : '' %>>Premium</option>
      </select>
    </div>
    <div class="mb-3">
      <label class="form-label">Price (Rp)</label>
      <input type="number" step="0.01" name="price" class="form-control" value="<%= product ? product.price : '' %>" required>
    </div>
    <div class="mb-3">
      <label class="form-label">Stock</label>
      <input type="number" name="stock" class="form-control" value="<%= product ? product.stock : '' %>" required>
    </div>
    <button type="submit" class="btn btn-primary">Save</button>
    <a href="/products" class="btn btn-link">Cancel</a>
  </form>
</div>

<%- include('../partials/footer') %>